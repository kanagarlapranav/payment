# =====================================================================
# Telegram Bot Configuration
# =====================================================================
# Get your bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:AAFakePlaceholderBotTokenForTesting35

# Numeric Telegram User ID of the bot owner (run get_chat_ids.py or /chatid to find this)
# Only this User ID has admin privileges (all mutations, exports, backups, restore, dashboard)
TELEGRAM_USER_ID=123456789

# Optional: Numeric Chat ID of your Telegram group (e.g. -100xxxxxxxxxx)
# Group members have read-only access (balance, history, stats, menu)
TELEGRAM_GROUP_ID=-1001234567890

# =====================================================================
# Server & Dashboard Security Configuration
# =====================================================================
# Optional static token for backward compatibility / administrative scripts
DASHBOARD_TOKEN=example_secure_dashboard_token_32chars

# HTTP Server Port (defaults to 10000 or port assigned by Render)
PORT=10000

# Your public Render service URL (used for links in /dashboard)
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# Timezone for transactions and daily scheduler (default: Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata

# Daily Financial Digest scheduled time in 24-hour IST format (default: 22:00)
DAILY_DIGEST_TIME=22:00

# =====================================================================
# Google Gemini Vision AI Configuration
# =====================================================================
# Get from Google AI Studio (https://aistudio.google.com/)
# Can be provided via either GOOGLE_API_KEY or GEMINI_API_KEY
GEMINI_API_KEY=AIzaSyFakePlaceholderGeminiApiKeyForTesting35
GEMINI_MODEL=gemini-3.6-flash

# =====================================================================
# Google Drive Cloud Storage (Optional)
# =====================================================================
GDRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_fake_folder_id
GDRIVE_SERVICE_ACCOUNT_JSON= # File path or raw JSON string
GDRIVE_CLIENT_ID=fake-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=GOCSPX-fakeClientSecretPlaceholder
GDRIVE_REFRESH_TOKEN=1//fakeRefreshTokenPlaceholder12345

# =====================================================================
# OCR Configuration
# =====================================================================
# RapidOCR (ONNX Runtime) is bundled as the local OCR engine.
# No external Tesseract installation is required.
