# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
TELEGRAM_GROUP_ID=your_telegram_group_id_here # Optional: required if using a specific group

# OCR Configuration (Windows example for Tesseract)
