# =====================================================================
# Telegram Bot Configuration
# =====================================================================
# Get your bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Numeric Telegram User ID of the bot owner (run get_chat_ids.py to find this)
TELEGRAM_USER_ID=123456789

# Optional: Numeric Chat ID of your Telegram group (e.g. -100xxxxxxxxxx)
TELEGRAM_GROUP_ID=-1001234567890

# =====================================================================
# Dashboard & Security Configuration
# =====================================================================
# Secret key to secure /api/data and web dashboard access
DASHBOARD_TOKEN=your_secret_dashboard_token_here

# Your public Render service URL (used for links in /dashboard)
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# =====================================================================
# Google Gemini Vision AI Configuration
# =====================================================================
# Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# =====================================================================
# Google Drive Cloud Storage (Optional)
# =====================================================================
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
GDRIVE_SERVICE_ACCOUNT_JSON= # File path or raw JSON string
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# =====================================================================
# Local OCR Fallback (Optional)
# =====================================================================
# Windows path example; on Linux/Render it automatically defaults to 'tesseract'
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
